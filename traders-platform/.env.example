# Copia este fichero a .env.local y rellena los valores.
# La app NO arranca si algo de esto rompe las reglas del entorno privado
# (ver src/lib/env-guard.ts).

# --- Regla nº1: entorno privado --------------------------------------------
# Debe ser exactamente "false". Cualquier otro valor bloquea el arranque.
# Abrir al público exige completar el checklist del README y retirar la
# guarda en el código de forma deliberada.
PUBLIC_LAUNCH=false

# Máximo 3 emails, separados por comas. Solo estos pueden entrar.
ALLOWED_EMAILS=admin@example.com,trader@example.com,suscriptor@example.com
# Admins de pruebas (uno o varios de los anteriores, separados por comas).
# Entran como admin y pueden cambiar su modo (admin / trader / suscriptor)
# desde "Mi cuenta" para probar todas las vistas.
ADMIN_EMAILS=admin@example.com

# URL de la app (para el enlace mágico del login).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Supabase (valores de `npx supabase status` en local) ------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe: SOLO MODO TEST -------------------------------------------------
# Claves sk_test_/pk_test_. Una clave live (sk_live_, pk_live_, rk_live_)
# en CUALQUIER variable bloquea el arranque. (Se usan a partir de la fase 3.)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
